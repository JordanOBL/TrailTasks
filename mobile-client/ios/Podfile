# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'TrailTasks' do
  # Keep explicit pods in the same target scope as autolinked React Native pods.
  # Root-level react-native-config created a second React-Core variant and
  # duplicate React-Core privacy-bundle archive products.
  pod 'simdjson', path: '../node_modules/@nozbe/simdjson', modular_headers: true
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'TrailTasksTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    installer.pods_project.targets.each do |target|
      # Xcode 27 rejects old resource-bundle deployment floors (13/14).
      # Raise only unsupported floors; never lower a pod's declared minimum.
      target.build_configurations.each do |build_config|
        floor = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if floor.nil? || Gem::Version.new(floor) < Gem::Version.new(min_ios_version_supported)
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
        end
      end
      if target.name == 'react-native-config'
        target.shell_script_build_phases.each do |phase|
          next unless phase.name.include?('Config codegen')
          # Run before the library's Ruby reader: reject missing ENVFILE and
          # /tmp/envfile, both of which can silently select the wrong backend.
          phase.shell_script = %q(set -e
python3 "${PODS_ROOT}/../../scripts/check-native-env.py" "${PODS_ROOT}/../.." ios
) + phase.shell_script
          # Selected file/contents can change without Ruby source changing.
          phase.always_out_of_date = '1'
        end
      end
    end

    # RN's post-install keeps the supported iOS floor without lowering pods
    # that declare a higher minimum. Keep generated privacy/resource targets.

    # Swift 6.4 synthesizes an ambiguous optional-var memberwise initializer.
    # Verified on these exact RevenueCat releases; do not mutate unknown SDKs.
    revenuecat_paywall_color = File.join(
      installer.sandbox.root.to_s,
      'RevenueCat/Sources/Paywalls/PaywallColor.swift'
    )
    needs_color_compat = installer.pod_targets.any? do |pod_target|
      pod_target.root_spec.name == 'RevenueCat' &&
        ['5.22.2', '5.67.1'].include?(pod_target.root_spec.version.to_s)
    end
    if needs_color_compat
      old_line = '    fileprivate var _underlyingColor: (any Sendable)?'
      new_line = '    fileprivate let _underlyingColor: (any Sendable)?'
      paywall_color_contents = File.read(revenuecat_paywall_color)
      if paywall_color_contents.scan(old_line).length == 1 && !paywall_color_contents.include?(new_line)
        File.chmod(0644, revenuecat_paywall_color)
        File.write(revenuecat_paywall_color, paywall_color_contents.sub(old_line, new_line))
      elsif paywall_color_contents.scan(new_line).length != 1 || paywall_color_contents.include?(old_line)
        raise 'Unknown RevenueCat PaywallColor source; review Swift compatibility before building'
      end
    end
  end
end

